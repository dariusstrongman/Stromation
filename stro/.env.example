# Stro's credentials — HIS OWN accounts, shared with nothing else.
ANTHROPIC_API_KEY=            # fresh key made only for Stro
SUPABASE_URL=                 # fresh Supabase project (not ReadyMadeVideo's)
SUPABASE_SERVICE_ROLE_KEY=
STRO_MAX_TURNS=40             # per-session turn ceiling (cost bound)
STRO_WORKSPACE=/workspace     # scratch disk; durable things go in memory/journal

# --- inference provider ---------------------------------------------------
# Default is the direct Anthropic API. To buy inference through Amazon
# Bedrock instead (the intended path — AWS credits are redeemable against
# it), set these. Model ids are region-dependent: confirm them in the
# Bedrock console under Model access before switching.
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# STRO_BEDROCK_MODEL_MAP={"claude-sonnet-5":"us.anthropic.claude-sonnet-5-v1:0"}
